                "description": "ID of the partner"
              },
              {
                "name": "campaign_id",
                "value": "10l176",
                "type": "query",
                "description": "ID of the campaign to restrict output to"
              },
              {
                "name": "active",
                "value": "y",
                "type": "query",
                "description": "Filter by active"
              }
            ]
