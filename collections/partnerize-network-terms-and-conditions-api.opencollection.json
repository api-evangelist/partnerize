{
  "opencollection": "1.0.0",
  "info": {
    "name": "Partnerize Brands Attribution Network Terms and Conditions API",
    "version": "1.4.99"
  },
  "items": [
    {
      "info": {
        "name": "Network Terms and Conditions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all terms and conditions for a network",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partnerize.com/reference/terms/:locale/:country/:network_id",
            "params": [
              {
                "name": "locale",
                "value": "en",
                "type": "path",
                "description": "Specified locale"
              },
              {
                "name": "country",
                "value": "GB",
                "type": "path",
                "description": "Specified ISO-2 country code"
              },
              {
                "name": "network_id",
                "value": "11l100",
                "type": "path",
                "description": "ID of the network"
              }
            ]
          },
          "docs": "List all terms and conditions for a network"
        }
      ]
    }
  ],
  "bundled": true
}