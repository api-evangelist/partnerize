            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partnerize.com/v3/brand/partnerize-tags",
            "params": [
              {
                "name": "brand_id",
                "value": "111111l3",
                "type": "query",
                "description": "ID of the brand to restrict scope of Partnerize Tags to"
              },
              {
                "name": "with_features",
                "value": "true",
                "type": "query",
                "description": "Optional flag to include features as part of the response"
              }
            ]
          },
          "docs": "Return a list of available Partnerize Tags."
