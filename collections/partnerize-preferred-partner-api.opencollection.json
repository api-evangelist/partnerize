          "http": {
            "method": "GET",
            "url": "https://api.partnerize.com/v2/campaigns/:campaignId/attribution/preferred-partners/:id",
            "params": [
              {
                "name": "campaignId",
                "value": "",
                "type": "path",
                "description": "The ID of the Campaign"
              },
              {
                "name": "id",
                "value": "10110l2398476",
                "type": "path",
                "description": "The Preferred Partner ID"
              }
            ]
          },
          "docs": "Get a Preferred Partner by ID"
        },
